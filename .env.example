# CareView AI Environment Configuration
# Optional: Provide one of the supported AI LLM providers for live natural language answers.
# If omitted or left blank, CareView AI operates in its high-performance built-in Demo Engine
# utilizing the local hospital knowledge base and safety escalation guardrails.

# Option 1: OpenAI (GPT-4o, GPT-4o-mini, GPT-3.5-turbo)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Option 2: Google Gemini (Gemini 1.5 Flash / Pro)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Option 3: Anthropic Claude (Claude 3.5 Sonnet / Haiku)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Hospital Configuration Demo Defaults
DEFAULT_HOSPITAL_NAME="St. Jude Memorial Hospital"
DEFAULT_WING="Maple Pavilion - Floor 4"
DEFAULT_ROOM="Room 402"
